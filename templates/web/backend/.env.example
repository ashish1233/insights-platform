# Copy to .env for local development. .env is gitignored and must stay that way
# — the secret-scanning hook in .pre-commit-config.yaml is the backstop, not the
# control (ADR-3: a credential in git history is not removable in practice).
#
# In a deployed environment the platform sets all of these. Nothing in this file
# is a secret today, but treat it as if it were, because the first thing a team
# adds to it is one.

# --- Platform-assigned. Do not invent values for these in production. ---------

# Your tenant id, issued at onboarding.
INSIGHTS_TENANT_ID=todo-your-tenant

# ADR-2: tier is a platform decision, not a self-assessment. "standard" is the
# default and almost certainly yours. Setting "restricted" here locally only
# changes how strict your own app is with itself; it does not grant you
# restricted-tier warehouse grants or the fail-closed audit path in production.
INSIGHTS_TIER=standard

# --- Platform endpoints. Local stubs by default. ------------------------------

INSIGHTS_IDP_URL=http://localhost:8081
INSIGHTS_WAREHOUSE_URL=http://localhost:8082
INSIGHTS_AUDIT_URL=http://localhost:8083

# --- Local development only ---------------------------------------------------

# The stub IdP signs tokens with a shared secret so you can mint one locally.
# Real deployments verify against the corporate IdP's published keys and this
# variable is unset. If you ever see it set in a deployed environment, that is
# an incident, not a configuration choice.
# INSIGHTS_TOKEN_SECRET=dev-only-insecure-secret-replaced-by-the-idp-in-any-real-deployment
