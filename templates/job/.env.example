# Copy to .env for local development. .env is gitignored and must stay that way
# — the secret-scanning hook in .pre-commit-config.yaml is the backstop, not the
# control (ADR-3: a credential in git history is not removable in practice, it
# has to be rotated, and rotation is manual today — ADR-5 item 5).

# --- Platform-assigned. Do not invent values for these in production. ---------

INSIGHTS_TENANT_ID=todo-your-tenant

# ADR-2: tier is a platform decision, not a self-assessment.
INSIGHTS_TIER=standard

# --- Platform endpoints. Local stubs by default. ------------------------------

# The job calls POST {INSIGHTS_IDP_URL}/token/service to exchange its deploy-time
# credential for a short-lived *service* token. There is no user token anywhere
# in a job's life, and nothing here should ever be one (ADR-1, ADR-4).
INSIGHTS_IDP_URL=http://localhost:8081
INSIGHTS_WAREHOUSE_URL=http://localhost:8082
INSIGHTS_AUDIT_URL=http://localhost:8083

# --- Local development only ---------------------------------------------------

# The stub IdP signs with a shared secret. Real deployments verify against the
# corporate IdP's published keys and leave this unset; seeing it set in a
# deployed environment is an incident, not a configuration choice.
# INSIGHTS_TOKEN_SECRET=dev-only-insecure-secret-replaced-by-the-idp-in-any-real-deployment
