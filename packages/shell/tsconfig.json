{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client"]
  },
  // `vite.config.ts` is included on purpose: it imports the app registry to
  // build its federation `remotes` map, so the tier rule is typechecked where
  // it is applied rather than only where it is declared.
  "include": ["src", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
