{
  "name": "@insights-platform/shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Micro-frontend host for the Insights Hub. Federates standard-tier apps; links out to restricted-tier ones (ADR-2).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "serve": "npm run build && npm run preview"
  },
  "dependencies": {
    "@insights-platform/ui-kit": "file:../../../insights-ui-kit",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
